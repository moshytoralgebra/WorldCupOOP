<UserControl x:Class="WorldCup.WPF.Controls.PlayerFieldControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="70" Height="90"
             Background="Transparent"
             Cursor="Hand"
             RenderTransformOrigin="0.5,0.5"
             MouseLeftButtonDown="UserControl_MouseLeftButtonDown">

    <UserControl.RenderTransform>
        <ScaleTransform x:Name="controlScale" ScaleX="1" ScaleY="1"/>
    </UserControl.RenderTransform>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

        <Grid Width="44" Height="44" HorizontalAlignment="Center">
            <Ellipse x:Name="playerEllipse" Width="44" Height="44" StrokeThickness="2"/>
            <TextBlock x:Name="lblNumber"
                       FontSize="13" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>

        <Border Background="#AA000000" CornerRadius="2"
                Padding="2,1" Margin="1,3,1,0">
            <TextBlock x:Name="lblName"
                       FontSize="8" Foreground="White"
                       TextAlignment="Center" TextWrapping="NoWrap"/>
        </Border>

    </StackPanel>
</UserControl>
