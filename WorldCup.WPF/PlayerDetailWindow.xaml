<Window x:Class="WorldCup.WPF.PlayerDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Player"
        Width="360" Height="480"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Opacity="0"
        Loaded="PlayerDetailWindow_Loaded">

    <Grid x:Name="rootGrid">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="rootTranslate" Y="60"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="160"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="headerGrid" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="20,0,8,0">
                <TextBlock x:Name="lblPlayerName"
                           FontSize="18" FontWeight="Bold" Foreground="White"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="lblPlayerNumber"
                           FontSize="32" FontWeight="Bold" Foreground="White"
                           Opacity="0.6" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Ellipse x:Name="playerEllipse"
                         Width="100" Height="100"
                         Stroke="White" StrokeThickness="2"/>
                <TextBlock x:Name="lblPhotoNumber"
                           FontSize="28" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Background="White" Margin="0">
            <Grid Margin="20,16,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="lblNameKey" Grid.Row="0" Grid.Column="0"
                           Text="Name" Foreground="#555" Padding="0,6"/>
                <TextBlock x:Name="valName" Grid.Row="0" Grid.Column="1"
                           FontWeight="Bold" TextWrapping="Wrap" Padding="0,6"/>

                <TextBlock x:Name="lblNumberKey" Grid.Row="1" Grid.Column="0"
                           Text="Number" Foreground="#555" Padding="0,6"/>
                <TextBlock x:Name="valNumber" Grid.Row="1" Grid.Column="1"
                           FontWeight="Bold" Padding="0,6"/>

                <TextBlock x:Name="lblPositionKey" Grid.Row="2" Grid.Column="0"
                           Text="Position" Foreground="#555" Padding="0,6"/>
                <TextBlock x:Name="valPosition" Grid.Row="2" Grid.Column="1"
                           FontWeight="Bold" Padding="0,6"/>

                <TextBlock x:Name="lblCaptainKey" Grid.Row="3" Grid.Column="0"
                           Text="Captain" Foreground="#555" Padding="0,6"/>
                <TextBlock x:Name="valCaptain" Grid.Row="3" Grid.Column="1"
                           FontWeight="Bold" Padding="0,6"/>

                <TextBlock x:Name="lblGoalsKey" Grid.Row="4" Grid.Column="0"
                           Text="Goals" Foreground="#555" Padding="0,6"/>
                <TextBlock x:Name="valGoals" Grid.Row="4" Grid.Column="1"
                           FontWeight="Bold" Padding="0,6"/>

                <TextBlock x:Name="lblYellowKey" Grid.Row="5" Grid.Column="0"
                           Text="Yellow Cards" Foreground="#555" Padding="0,6"/>
                <TextBlock x:Name="valYellow" Grid.Row="5" Grid.Column="1"
                           FontWeight="Bold" Padding="0,6"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                Padding="16,10">
            <Button x:Name="btnClose" Content="Close"
                    IsCancel="True" HorizontalAlignment="Right"
                    MinWidth="80" Padding="12,5"
                    Click="btnClose_Click"/>
        </Border>
    </Grid>
</Window>
