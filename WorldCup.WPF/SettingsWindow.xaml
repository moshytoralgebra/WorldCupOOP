<Window x:Class="WorldCup.WPF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        MinWidth="400" MinHeight="350"
        Width="460" Height="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,12">

                <TextBlock x:Name="lblChampionship" Text="Championship"
                           FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                <RadioButton x:Name="rbMale"   Content="Male (2018)"
                             GroupName="Gender" Margin="8,0,0,4"
                             Checked="RadioButton_Checked"/>
                <RadioButton x:Name="rbFemale" Content="Female (2019)"
                             GroupName="Gender" Margin="8,0,0,0"
                             Checked="RadioButton_Checked"/>

                <TextBlock x:Name="lblLanguage" Text="Language"
                           FontWeight="SemiBold" FontSize="13" Margin="0,20,0,8"/>
                <ComboBox x:Name="cbLanguage" MaxWidth="280" HorizontalAlignment="Left"
                          SelectionChanged="cbLanguage_SelectionChanged">
                    <ComboBoxItem Content="English"  Tag="en"/>
                    <ComboBoxItem Content="Hrvatski" Tag="hr"/>
                </ComboBox>

                <TextBlock x:Name="lblWindowSize" Text="Window Size"
                           FontWeight="SemiBold" FontSize="13" Margin="0,20,0,8"/>
                <ComboBox x:Name="cbWindowSize" MaxWidth="280" HorizontalAlignment="Left"
                          SelectionChanged="cbWindowSize_SelectionChanged">
                    <ComboBoxItem x:Name="cbiFullscreen" Content="Fullscreen"        Tag="Fullscreen"/>
                    <ComboBoxItem x:Name="cbiLarge"      Content="Large (1280x720)"  Tag="Large (1280x720)"/>
                    <ComboBoxItem x:Name="cbiMedium"     Content="Medium (1024x768)" Tag="Medium (1024x768)"/>
                    <ComboBoxItem x:Name="cbiSmall"      Content="Small (800x600)"   Tag="Small (800x600)"/>
                </ComboBox>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="32,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnConfirm" Content="Confirm" IsDefault="True"
                        Click="btnConfirm_Click"
                        MinWidth="90" Padding="12,6" Margin="0,0,10,0"
                        IsEnabled="False"/>
                <Button x:Name="btnCancel" Content="Cancel" IsCancel="True"
                        Click="btnCancel_Click"
                        MinWidth="90" Padding="12,6"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
