<Window x:Class="WorldCup.WPF.TeamInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Team Info"
        Width="400" Height="420"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Opacity="0"
        Loaded="TeamInfoWindow_Loaded">

    <Grid x:Name="rootGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="rootScale" ScaleX="0.85" ScaleY="0.85"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#1A237E">
            <StackPanel VerticalAlignment="Center" Margin="24,0">
                <TextBlock x:Name="lblCountry"
                           FontSize="22" FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock x:Name="lblFifaCode"
                           FontSize="14"
                           Foreground="#B0BEC5" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Background="White"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,16,24,8" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="lblGamesPlayed" Grid.Row="0" Grid.Column="0"
                           Text="Games Played" VerticalAlignment="Center" Padding="0,5"/>
                <TextBlock x:Name="valGamesPlayed" Grid.Row="0" Grid.Column="1"
                           FontWeight="Bold" VerticalAlignment="Center" Padding="0,5"/>

                <TextBlock x:Name="lblWins" Grid.Row="1" Grid.Column="0"
                           Text="Wins" VerticalAlignment="Center" Padding="0,5"/>
                <TextBlock x:Name="valWins" Grid.Row="1" Grid.Column="1"
                           FontWeight="Bold" VerticalAlignment="Center" Padding="0,5"/>

                <TextBlock x:Name="lblDraws" Grid.Row="2" Grid.Column="0"
                           Text="Draws" VerticalAlignment="Center" Padding="0,5"/>
                <TextBlock x:Name="valDraws" Grid.Row="2" Grid.Column="1"
                           FontWeight="Bold" VerticalAlignment="Center" Padding="0,5"/>

                <TextBlock x:Name="lblLosses" Grid.Row="3" Grid.Column="0"
                           Text="Losses" VerticalAlignment="Center" Padding="0,5"/>
                <TextBlock x:Name="valLosses" Grid.Row="3" Grid.Column="1"
                           FontWeight="Bold" VerticalAlignment="Center" Padding="0,5"/>

                <TextBlock x:Name="lblGoalsScored" Grid.Row="4" Grid.Column="0"
                           Text="Goals Scored" VerticalAlignment="Center" Padding="0,5"/>
                <TextBlock x:Name="valGoalsScored" Grid.Row="4" Grid.Column="1"
                           FontWeight="Bold" VerticalAlignment="Center" Padding="0,5"/>

                <TextBlock x:Name="lblGoalsConceded" Grid.Row="5" Grid.Column="0"
                           Text="Goals Conceded" VerticalAlignment="Center" Padding="0,5"/>
                <TextBlock x:Name="valGoalsConceded" Grid.Row="5" Grid.Column="1"
                           FontWeight="Bold" VerticalAlignment="Center" Padding="0,5"/>

                <TextBlock x:Name="lblGoalDiff" Grid.Row="6" Grid.Column="0"
                           Text="Goal Difference" VerticalAlignment="Center" Padding="0,5"/>
                <TextBlock x:Name="valGoalDiff" Grid.Row="6" Grid.Column="1"
                           FontWeight="Bold" VerticalAlignment="Center" Padding="0,5"/>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                Padding="16,10">
            <Button x:Name="btnClose" Content="Close"
                    IsCancel="True" HorizontalAlignment="Right"
                    MinWidth="80" Padding="12,5"
                    Click="btnClose_Click"/>
        </Border>
    </Grid>
</Window>
